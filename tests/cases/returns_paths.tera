// Every path through these functions returns a value, so the checker accepts them:
// `if`/`else` chains, `switch` with a `default`, `while (true)` and early returns.

fn sign(n: int) => int {
  if (n < 0) {
    return -1
  } else if (n > 0) {
    return 1
  } else {
    return 0
  }
}

fn label(n: int) => string {
  switch (n) {
    case 1:
      return "one"
    case 2:
      return "two"
    default:
      return "many"
  }
}

// `while (true)` with no `break` never reaches the closing brace of the function.
fn countUpTo(limit: int) => int {
  let i: 0 => int
  while (true) {
    i = i + 1
    if (i >= limit) {
      return i
    }
  }
}

// A `break` inside a nested loop belongs to that loop, so the outer `while (true)` still
// cannot finish.
fn sumUpTo(n: int) => int {
  let total: 0 => int
  while (true) {
    for i: 0..2 {
      if (i >= n) {
        break
      }
      total = total + i
    }
    return total
  }
}

// A `return` in the middle makes the rest of the body unreachable, so that part need not
// return anything either.
fn firstNonZero(a: int, b: int) => int {
  if (a != 0) {
    return a
  }
  return b
}

print("sign(-5):", sign(-5))
print("sign(0):", sign(0))
print("sign(5):", sign(5))
print("label(1):", label(1))
print("label(2):", label(2))
print("label(9):", label(9))
print("countUpTo(3):", countUpTo(3))
print("sumUpTo(2):", sumUpTo(2))
print("firstNonZero(0, 7):", firstNonZero(0, 7))
